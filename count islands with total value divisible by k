class Solution(object):
    def countIslands(self, grid, k):
        rows = len(grid)
        cols = len(grid[0])

        count = 0

        for i in range(rows):
            for j in range(cols):

                if grid[i][j] > 0:
                    total = 0
                    stack = [(i, j)]

                    while stack:
                        r, c = stack.pop()

                        if r < 0 or r >= rows or c < 0 or c >= cols:
                            continue

                        if grid[r][c] == 0:
                            continue

                        total += grid[r][c]
                        grid[r][c] = 0

                        stack.append((r - 1, c))
                        stack.append((r + 1, c))
                        stack.append((r, c - 1))
                        stack.append((r, c + 1))

                    if total % k == 0:
                        count += 1

        return count
