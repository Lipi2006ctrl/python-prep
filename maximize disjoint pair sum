t = int(input())

for _ in range(t):
    n, d = map(int, input().split())
    arr = list(map(int, input().split()))

    arr.sort()

    dp = [0] * (n + 1)

    for i in range(2, n + 1):
        dp[i] = dp[i - 1]

        if arr[i - 1] - arr[i - 2] < d:
            dp[i] = max(
                dp[i],
                dp[i - 2] + arr[i - 1] + arr[i - 2]
            )

    print(dp[n])
