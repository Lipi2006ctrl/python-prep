def myAtoi(s: str) -> int:
    i = 0
    sign = 1
    result = 0

    # Skip spaces
    while i < len(s) and s[i] == ' ':
        i += 1

    # Check sign
    if i < len(s) and s[i] == '-':
        sign = -1
        i += 1
    elif i < len(s) and s[i] == '+':
        i += 1

    # Read digits
    while i < len(s) and s[i].isdigit():

        digit = int(s[i])

        result = result * 10 + digit

        i += 1

    result = result * sign

    # Check range
    if result < -2147483648:
        return -2147483648

    if result > 2147483647:
        return 2147483647

    return result
