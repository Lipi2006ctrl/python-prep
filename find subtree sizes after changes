class Solution(object):
    def findSubtreeSizes(self, parent, s):
        n = len(parent)

        children = [[] for _ in range(n)]
        for i in range(1, n):
            children[parent[i]].append(i)

        new_parent = parent[:]
        last_seen = [-1] * 26

        # Find new parents using original tree
        stack = [(0, 0, -1)]

        while stack:
            node, state, old = stack.pop()
            c = ord(s[node]) - ord('a')

            if state == 0:
                old = last_seen[c]

                if node != 0 and old != -1:
                    new_parent[node] = old

                last_seen[c] = node

                stack.append((node, 1, old))

                for child in reversed(children[node]):
                    stack.append((child, 0, -1))

            else:
                last_seen[c] = old

        # Build the modified tree
        new_children = [[] for _ in range(n)]

        for i in range(1, n):
            new_children[new_parent[i]].append(i)

        # Get traversal order
        order = []
        stack = [0]

        while stack:
            node = stack.pop()
            order.append(node)

            for child in new_children[node]:
                stack.append(child)

        # Calculate subtree sizes
        answer = [1] * n

        for node in reversed(order):
            for child in new_children[node]:
                answer[node] += answer[child]

        return answer
