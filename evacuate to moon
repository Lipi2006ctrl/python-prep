t = int(input())

for _ in range(t):
    n, m, h = map(int, input().split())

    a = list(map(int, input().split()))
    b = list(map(int, input().split()))

    a.sort()
    b.sort()

    k = min(n, m)
    total = 0

    for i in range(1, k + 1):
        total += min(a[-i], b[-i] * h)

    print(total)
