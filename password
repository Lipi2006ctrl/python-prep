def issecure(s):
    if len(s)<10:
        return "NO"
    inside=s[1:-1]
    lower=False
    upper=False
    digit=False
    splchar=False
    for c in s:
        if c.islower():
            lower=True
    for c in inside:
        if c.isupper():
            upper=True
        elif c.isdigit():
            digit=True
        elif c in "@#%&?":
            splchar=True
    if lower and upper and digit and splchar:
        return "YES"
    else:
        return "NO"
t=int(input())
for i in range(t):
    s=input()
    print(issecure(s))
