t = int(input())

while t > 0:
    s = input()

    digits = list(s)

    i = len(digits) - 1

    while i >= 0 and digits[i] == '9':
        digits[i] = '0'
        i -= 1

    if i >= 0:
        digits[i] = str(int(digits[i]) + 1)
    else:
        digits.insert(0, '1')

    print(''.join(digits))

    t -= 1
