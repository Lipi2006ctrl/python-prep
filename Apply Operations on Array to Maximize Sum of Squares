
class Solution(object):
    def maxSum(self, nums, k):
        MOD = 10**9 + 7
        n = len(nums)

        # Count how many numbers contain each bit
        bits = [0] * 32

        for num in nums:
            for b in range(32):
                if num & (1 << b):
                    bits[b] += 1

        answer = 0

        # Build the k largest possible numbers
        for _ in range(k):
            num = 0

            for b in range(32):
                if bits[b] > 0:
                    num |= (1 << b)
                    bits[b] -= 1

            answer = (answer + num * num) % MOD

        return answer
