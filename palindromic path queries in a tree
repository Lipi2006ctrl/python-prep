class Solution(object):
    def canMakePalindromeQueries(self, n, edges, s, queries):
        adj = [[] for _ in range(n)]

        for u, v in edges:
            adj[u].append(v)
            adj[v].append(u)

        parent = [0] * n
        depth = [0] * n
        tin = [0] * n
        tout = [0] * n
        order = []

        timer = 0
        stack = [(0, -1, 0)]

        while stack:
            u, p, state = stack.pop()

            if state == 0:
                parent[u] = u if p == -1 else p
                tin[u] = timer
                timer += 1
                order.append(u)

                stack.append((u, p, 1))

                for v in reversed(adj[u]):
                    if v != p:
                        depth[v] = depth[u] + 1
                        stack.append((v, u, 0))

            else:
                tout[u] = timer

        LOG = n.bit_length()
        up = [[0] * n for _ in range(LOG)]

        up[0] = parent[:]

        for j in range(1, LOG):
            for i in range(n):
                up[j][i] = up[j - 1][up[j - 1][i]]

        def lca(u, v):
            if depth[u] < depth[v]:
                u, v = v, u

            diff = depth[u] - depth[v]

            for j in range(LOG):
                if diff & (1 << j):
                    u = up[j][u]

            if u == v:
                return u

            for j in range(LOG - 1, -1, -1):
                if up[j][u] != up[j][v]:
                    u = up[j][u]
                    v = up[j][v]

            return parent[u]

        s = list(s)

        prefix = [0] * n

        for u in order:
            bit = 1 << (ord(s[u]) - ord('a'))

            if u == 0:
                prefix[u] = bit
            else:
                prefix[u] = prefix[parent[u]] ^ bit

        fenwick = [0] * (n + 1)

        def update(idx, val):
            idx += 1

            while idx <= n:
                fenwick[idx] ^= val
                idx += idx & -idx

        def range_update(left, right, val):
            update(left, val)

            if right < n:
                update(right, val)

        def get(idx):
            idx += 1
            result = 0

            while idx > 0:
                result ^= fenwick[idx]
                idx -= idx & -idx

            return result

        def get_prefix(u):
            return prefix[u] ^ get(tin[u])

        answer = []

        for q in queries:
            parts = q.split()
            operation = parts[0]

            if operation == "update":
                u = int(parts[1])
                c = parts[2]

                old_bit = 1 << (ord(s[u]) - ord('a'))
                new_bit = 1 << (ord(c) - ord('a'))

                delta = old_bit ^ new_bit

                range_update(tin[u], tout[u], delta)

                s[u] = c

            else:
                u = int(parts[1])
                v = int(parts[2])

                w = lca(u, v)

                mask = get_prefix(u) ^ get_prefix(v)
                mask ^= 1 << (ord(s[w]) - ord('a'))

                answer.append(mask == 0 or (mask & (mask - 1)) == 0)

        return answer
