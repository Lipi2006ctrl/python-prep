t = int(input())

while t > 0:
    s = input()
    count = 0
    found = False

    for ch in s:
        if ch in "aeiou":
            count += 1
            if count >= 3:
                print("HAPPY")
                found = True
                break
        else:
            count = 0

    if not found:
        print("SAD")

    t -= 1
