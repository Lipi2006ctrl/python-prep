class Solution(object):
    def smallestUniqueSubarray(self, nums):
        n = len(nums)

        sa = list(range(n))
        rank = nums[:]
        k = 1

        # Build suffix array
        while k < n:
            sa.sort(key=lambda i: (rank[i],
                                  rank[i + k] if i + k < n else -1))

            new_rank = [0] * n

            for j in range(1, n):
                a = sa[j - 1]
                b = sa[j]

                key_a = (rank[a], rank[a + k] if a + k < n else -1)
                key_b = (rank[b], rank[b + k] if b + k < n else -1)

                new_rank[b] = new_rank[a] + (key_a != key_b)

            rank = new_rank
            k *= 2

        # Build LCP array
        lcp = [0] * n
        rank_pos = [0] * n

        for i in range(n):
            rank_pos[sa[i]] = i

        h = 0

        for i in range(n):
            pos = rank_pos[i]

            if pos == 0:
                h = 0
                continue

            j = sa[pos - 1]

            while i + h < n and j + h < n and nums[i + h] == nums[j + h]:
                h += 1

            lcp[pos] = h

            if h > 0:
                h -= 1

        # Find the shortest unique subarray
        ans = n

        for pos in range(n):
            left = lcp[pos]
            right = lcp[pos + 1] if pos + 1 < n else 0

            shortest = max(left, right) + 1
            suffix_length = n - sa[pos]

            if shortest <= suffix_length:
                ans = min(ans, shortest)

        return ans
