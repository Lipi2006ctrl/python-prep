t = int(input())

for _ in range(t):
    n, h = map(int, input().split())
    arr = list(map(int, input().split()))

    low = 1
    high = max(arr)

    while low < high:
        mid = (low + high) // 2

        total = 0

        for bananas in arr:
            total += (bananas + mid - 1) // mid

        if total <= h:
            high = mid
        else:
            low = mid + 1

    print(low)
