class Solution(object):
    def minimumCost(self, cost1, cost2, costBoth, need1, need2):
        a = min(need1, need2)
        b = max(need1, need2)

        option1 = need1 * cost1 + need2 * cost2

        option2 = a * costBoth + (need1 - a) * cost1 + (need2 - a) * cost2

        option3 = b * costBoth

        return min(option1, option2, option3)
