def encode_dna(s):
    result = ""

    for i in range(0, len(s), 2):
        pair = s[i:i+2]

        if pair == "00":
            result += "A"
        elif pair == "01":
            result += "T"
        elif pair == "10":
            result += "C"
        else:
            result += "G"

    return result


T = int(input())

for _ in range(T):
    N = int(input())
    S = input()

    print(encode_dna(S))
