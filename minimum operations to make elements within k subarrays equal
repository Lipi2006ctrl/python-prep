class Solution(object):
    def minOperations(self, nums, x, k):
        n = len(nums)

        values = sorted(set(nums))
        m = len(values)

        pos = {v: i + 1 for i, v in enumerate(values)}

        count = [0] * (m + 1)
        sums = [0] * (m + 1)

        def update(bit, i, val):
            while i <= m:
                bit[i] += val
                i += i & -i

        def query(bit, i):
            total = 0
            while i > 0:
                total += bit[i]
                i -= i & -i
            return total

        def get_median():
            target = (x + 1) // 2
            idx = 0
            step = 1 << (m.bit_length() - 1)

            while step > 0:
                nxt = idx + step
                if nxt <= m and count[nxt] < target:
                    idx = nxt
                    target -= count[nxt]
                step //= 2

            return values[idx]

        def get_cost(median, total):
            p = pos[median]

            left_count = query(count, p)
            left_sum = query(sums, p)

            right_count = x - left_count
            right_sum = total - left_sum

            return (median * left_count - left_sum) + \
                   (right_sum - median * right_count)

        total = 0

        for i in range(x):
            update(count, pos[nums[i]], 1)
            update(sums, pos[nums[i]], nums[i])
            total += nums[i]

        costs = []

        for i in range(n - x + 1):
            median = get_median()
            costs.append(get_cost(median, total))

            if i < n - x:
                update(count, pos[nums[i]], -1)
                update(sums, pos[nums[i]], -nums[i])
                total -= nums[i]

                update(count, pos[nums[i + x]], 1)
                update(sums, pos[nums[i + x]], nums[i + x])
                total += nums[i + x]

        inf = float('inf')
        prev = [0] * (n + 1)

        for j in range(1, k + 1):
            curr = [inf] * (n + 1)

            for i in range(1, n + 1):
                curr[i] = curr[i - 1]

                if i >= x:
                    curr[i] = min(
                        curr[i],
                        prev[i - x] + costs[i - x]
                    )

            prev = curr

        return prev[n]
