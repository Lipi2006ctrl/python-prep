t = int(input())

for _ in range(t):
    n = int(input())
    arr = list(map(int, input().split()))

    freq = {}

    for x in arr:
        freq[x] = freq.get(x, 0) + 1

    maximum = max(freq.values())

    if list(freq.values()).count(maximum) == 1:
        print("YES")
    else:
        print("NO")
