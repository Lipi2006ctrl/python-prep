
class Solution(object):
    def sortableIntegers(self, nums):
        n = len(nums)
        target = sorted(nums)
        ans = 0

        def is_rotation(a, b):
            k = len(a)

            # KMP prefix table for b
            lps = [0] * k
            j = 0

            for i in range(1, k):
                while j > 0 and b[i] != b[j]:
                    j = lps[j - 1]
                if b[i] == b[j]:
                    j += 1
                    lps[i] = j

            # Search b in a + a, considering starts before k
            j = 0
            for i in range(2 * k - 1):
                x = a[i % k]

                while j > 0 and x != b[j]:
                    j = lps[j - 1]

                if x == b[j]:
                    j += 1

                if j == k:
                    return True

            return False

        for k in range(1, n + 1):
            if n % k != 0:
                continue

            possible = True

            for start in range(0, n, k):
                a = nums[start:start + k]
                b = target[start:start + k]

                if not is_rotation(a, b):
                    possible = False
                    break

            if possible:
                ans += k

        return ans
