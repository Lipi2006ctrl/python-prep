t = int(input())

for _ in range(t):
    s = input().strip()

    lower = False
    upper = False
    digit = False
    special = False

    if len(s) >= 10:
        for i in range(len(s)):
            if 'a' <= s[i] <= 'z':
                lower = True

            if i != 0 and i != len(s) - 1:
                if 'A' <= s[i] <= 'Z':
                    upper = True
                elif '0' <= s[i] <= '9':
                    digit = True
                elif s[i] in '@#%&?':
                    special = True

    if lower and upper and digit and special and len(s) >= 10:
        print("YES")
    else:
        print("NO")
